# Docker Image Tag (Replace with your Docker Hub username/image:tag)
DOCKER_IMAGE=idibek/frappe-custom:v15

# MariaDB Root Password
DB_ROOT_PASSWORD=alik3669

# Frappe Administrator Password
ADMIN_PASSWORD=alik3669

# Default Site Name
SITE_NAME=mysite.localhost

# Exposed Web Port (80, 8080, etc.)
HTTP_PORT=8088

# -----------------------------------------------------------------------------
# Web Catalog & Customer Portal Integration (web_sync app)
# -----------------------------------------------------------------------------
# Webhook destination on Web backend (when running in frapper-net Docker network)
WEB_SYNC_URL=http://catalog_backend:8000/api/v1/webhooks/erpnext
# Shared secret for authenticating webhooks (matches ERPNEXT_WEBHOOK_SECRET in Web/.env)
WEB_SYNC_SECRET=my_shared_test_secret_123
# Enable/disable webhook dispatching (1 = enabled, 0 = disabled)
WEB_SYNC_ENABLED=1

# (Optional) GitHub Personal Access Token (auto-detected if saved on host)
# GITHUB_TOKEN=
