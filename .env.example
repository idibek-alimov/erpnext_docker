# Docker Image Tag (Replace with your Docker Hub username/image:tag)
DOCKER_IMAGE=idibek/frappe-custom:v15

# MariaDB Root Password
DB_ROOT_PASSWORD=mariadb_root_password

# Frappe Administrator Password
ADMIN_PASSWORD=admin_password

# Default Site Name
SITE_NAME=radolfa.localhost

# Exposed Web Port (80, 8080, etc.)
HTTP_PORT=80

# -----------------------------------------------------------------------------
# Web Catalog & Customer Portal Integration (web_sync app)
# -----------------------------------------------------------------------------
# Webhook destination on Web backend
WEB_SYNC_URL=https://api.yourdomain.com/api/v1/webhooks/erpnext
# Shared secret for authenticating webhooks (must match ERPNEXT_WEBHOOK_SECRET in Web/.env)
WEB_SYNC_SECRET=your_shared_secret_here
# Enable/disable webhook dispatching (1 = enabled, 0 = disabled)
WEB_SYNC_ENABLED=1

# (Optional) GitHub Personal Access Token (auto-detected if saved on host)
# GITHUB_TOKEN=ghp_your_token_here
